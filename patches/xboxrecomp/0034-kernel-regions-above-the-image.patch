diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index 054f33d..fc6ecdf 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -47,6 +47,9 @@ static ptrdiff_t g_memory_offset = 0;  /* actual_base - XBOX_BASE_ADDRESS */
 /* Actual mapped RAM for this run; see the header. Default retail 64 MB. */
 size_t g_xbox_total_ram = XBOX_TOTAL_RAM;
 size_t g_xbox_map_size = 0;   /* 0 = same as RAM */
+uint32_t g_xbox_kernel_data_base = XBOX_KERNEL_DATA_DEFAULT;
+uint32_t g_xbox_stack_base = XBOX_STACK_DEFAULT;
+static uint32_t g_heap_next;    /* the heap's bump pointer, defined below */
 
 void xbox_SetTotalRam(size_t bytes)
 {
@@ -1958,6 +1961,29 @@ BOOL xbox_MemoryLayoutInit(const void *xbe_data, size_t xbe_size)
                 header_size, XBOX_VA(XBOX_BASE_ADDRESS), XBOX_BASE_ADDRESS);
     }
 
+    /*
+     * Kernel data, the stack area and the heap go after the image.
+     * Their default addresses (0x00740000, 0x00780000, 0x00F80000 for the
+     * heap) sit above most images; one that reaches past the kernel data
+     * page (base + SizeOfImage, header +0x10C) moves all three above it,
+     * keeping their spacing.
+     */
+    {
+        DWORD base_addr = *(const DWORD *)(xbe + XBE_BASE_ADDR_OFFSET);
+        DWORD image_size = xbe_size >= 0x110 ? *(const DWORD *)(xbe + 0x10C) : 0;
+        uint32_t image_end = (base_addr + image_size + 0xFFFFu) & ~0xFFFFu;
+
+        g_xbox_kernel_data_base = XBOX_KERNEL_DATA_DEFAULT;
+        g_xbox_stack_base = XBOX_STACK_DEFAULT;
+        if (image_end > XBOX_KERNEL_DATA_DEFAULT) {
+            g_xbox_kernel_data_base = image_end;
+            g_xbox_stack_base = image_end + (XBOX_STACK_DEFAULT - XBOX_KERNEL_DATA_DEFAULT);
+        }
+        g_heap_next = XBOX_HEAP_BASE;
+        fprintf(stderr, "  image ends 0x%08X: kernel data 0x%08X, stack 0x%08X, heap 0x%08X\n",
+                image_end, g_xbox_kernel_data_base, g_xbox_stack_base, XBOX_HEAP_BASE);
+    }
+
     /*
      * Dynamically load ALL XBE sections by parsing the section headers.
      *
@@ -2872,7 +2898,7 @@ ptrdiff_t xbox_GetMemoryOffset(void)
  * Returns Xbox VAs within the mapped region so MEM32() works correctly.
  * No free support (bump-only for now).
  */
-static uint32_t g_heap_next = XBOX_HEAP_BASE;
+static uint32_t g_heap_next = XBOX_STACK_DEFAULT + XBOX_STACK_SIZE;  /* set again by xbox_MemoryLayoutInit */
 
 static int g_heap_alloc_count = 0;
 
diff --git a/src/kernel/xbox_memory_layout.h b/src/kernel/xbox_memory_layout.h
index eec0706..f167d1e 100644
--- a/src/kernel/xbox_memory_layout.h
+++ b/src/kernel/xbox_memory_layout.h
@@ -237,7 +237,16 @@ void xbox_WatchInit(void);
 /** Base VA for kernel data exports (XboxHardwareInfo, XboxKrnlVersion, etc.)
  *  These are kernel exports that are DATA, not functions. The game reads
  *  their thunk entries and dereferences them to access the data. */
-#define XBOX_KERNEL_DATA_BASE   0x00740000
+/* Runtime, not a constant: xbox_MemoryLayoutInit moves it (and the stack
+ * area, and the heap after it) above the image when the XBE reaches past
+ * 0x00740000. Panzer Dragoon Orta's second program, pd1.xbe, has .rdata and
+ * .data up to 0x00E60B20, over both. A title whose image ends below keeps
+ * the old addresses. */
+extern uint32_t g_xbox_kernel_data_base;
+extern uint32_t g_xbox_stack_base;
+#define XBOX_KERNEL_DATA_DEFAULT 0x00740000u
+#define XBOX_STACK_DEFAULT       0x00780000u
+#define XBOX_KERNEL_DATA_BASE   g_xbox_kernel_data_base
 #define XBOX_KERNEL_DATA_SIZE   4096   /* 4 KB - plenty for all data exports */
 
 /* Offsets within the kernel data area */
@@ -360,7 +369,7 @@ typedef union RecompXmm {
 extern RECOMP_TLS uint32_t g_fs_base;
 #define XBOX_FS_BASE        g_fs_base
 
-#define XBOX_STACK_BASE     0x00780000
+#define XBOX_STACK_BASE     g_xbox_stack_base     /* 0x00780000 by default */
 
 /** Initial ESP value (top of stack, 16-byte aligned). */
 #define XBOX_STACK_TOP      (XBOX_STACK_BASE + XBOX_STACK_SIZE - 16)
