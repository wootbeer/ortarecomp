--- /dev/null
+++ b/tools/recomp/test_lifter_cwd.py
@@ -0,0 +1,11 @@
+"""Tests for CWD lifting."""
+
+from tools.recomp.lifter import Instruction, Lifter
+
+
+def test_cwd_sets_dx_to_the_sign_of_ax():
+    insn = Instruction(0x1000, 2, "cwd", "", "6699")
+
+    assert Lifter().lift_instruction(insn) == [
+        "SET_LO16(edx, ((int16_t)LO16(eax) < 0) ? 0xFFFFu : 0u); /* cwd */",
+    ]
