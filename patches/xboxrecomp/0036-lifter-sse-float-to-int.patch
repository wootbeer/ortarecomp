+"""Tests for the SSE float-to-integer conversions (cvt[t]ss2si, cvt[t]sd2si)."""
+
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+
+def _insn(mnemonic, operands):
+    instruction = Instruction(0, 4, mnemonic, "", "")
+    instruction.operands = operands
+    return instruction
+
+
+def _reg(name):
+    return Operand(type="reg", reg=name)
+
+
+def _mem(base, size):
+    return Operand(type="mem", mem_base=base, mem_disp=0, mem_size=size)
+
+
+class SseConvertToIntTest(unittest.TestCase):
+    """The rounding forms follow MXCSR (round to nearest by default) and the
+    T forms truncate; both were lifted as C casts, which truncate, and whose
+    result for a value out of range is undefined in C."""
+
+    def lift(self, mnemonic, operands):
+        return Lifter().lift_instruction(_insn(mnemonic, operands))
+
+    def test_cvtss2si_rounds_by_mxcsr(self):
+        self.assertEqual(
+            self.lift("cvtss2si", [_reg("eax"), _mem("esp", 4)]),
+            ["eax = (uint32_t)SSE_CVT_I32((double)MEMF(esp), 0); /* cvtss2si */"])
+
+    def test_cvttss2si_truncates(self):
+        self.assertEqual(
+            self.lift("cvttss2si", [_reg("eax"), _reg("xmm0")]),
+            ["eax = (uint32_t)SSE_CVT_I32((double)xmm0.f[0], 1); /* cvttss2si */"])
+
+    def test_cvtsd2si_reads_the_double_lane(self):
+        self.assertEqual(
+            self.lift("cvtsd2si", [_reg("ecx"), _reg("xmm1")]),
+            ["ecx = (uint32_t)SSE_CVT_I32((double)xmm1.d[0], 0); /* cvtsd2si */"])
+
+    def test_cvttsd2si_from_memory_reads_a_double(self):
+        self.assertEqual(
+            self.lift("cvttsd2si", [_reg("edx"), _mem("eax", 8)]),
+            ["edx = (uint32_t)SSE_CVT_I32((double)MEMD(eax), 1); /* cvttsd2si */"])
+
+
+if __name__ == "__main__":
+    unittest.main()
