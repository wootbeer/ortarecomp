+/* CVTSS2SI / CVTSD2SI round as the guest's MXCSR says (RC, bits 13-14,
+ * coded as the x87's), CVTTSS2SI / CVTTSD2SI truncate; NaN and values out
+ * of range give the integer indefinite, 0x80000000. They were lifted as C
+ * casts: the rounding forms truncated (a value of 2.7 became 2, not 3), and
+ * a cast of a value out of range is undefined in C, so compilers differ. */
+static inline int32_t SSE_CVT_I32(double v, int truncate)
+{
+    double r = truncate ? trunc(v)
+                        : recomp_frndint(v, (uint16_t)(((g_mxcsr >> 13) & 3u) << 10));
+    if (!(r >= -2147483648.0 && r <= 2147483647.0))
+        return (int32_t)0x80000000u;
+    return (int32_t)r;
+}
