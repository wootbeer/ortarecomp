+"""
+Self-check for the carry flag of rol/ror.
+
+Run: py -3 tools/recomp/test_lifter_rol_ror_carry.py
+
+A rotate sets CF to the bit that went round (the result's lowest after rol,
+its highest after ror), unless the masked count is 0. It was never written,
+so a jb after a rotate tested the carry of whatever came before: pd1 rotates
+a dither mask a bit per pixel and skips the pixel on CF.
+"""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp.lifter import Lifter  # noqa: E402
+from tools.recomp.translator import FunctionTranslator  # noqa: E402
+
+
+class _Op:
+    def __init__(self, text, type="reg", reg=None, size=4, mem_size=None, imm=0):
+        self.text = text
+        self.type = type
+        self.reg = reg
+        self.size = size
+        self.mem_size = mem_size
+        self.imm = imm
+
+
+class _Insn:
+    def __init__(self, mnemonic, operands=(), op_str=""):
+        self.mnemonic = mnemonic
+        self.operands = list(operands)
+        self.op_str = op_str
+
+
+def _lift(mnemonic, ops, needs_cf=True):
+    lifter = Lifter()
+    lifter.needs_cf = needs_cf
+    return "\n".join(lifter.lift_instruction(_Insn(mnemonic, ops)))
+
+
+EAX = _Op("eax", reg="eax")
+ONE = _Op("1", type="imm", imm=1)
+
+
+def test_ror_carry_is_the_top_bit():
+    out = _lift("ror", [EAX, ONE])
+    assert "_cf = (int)(((eax) >> 31) & 1u)" in out, out
+    assert out.index("eax =") < out.index("_cf ="), out   # read after the rotate
+
+
+def test_rol_carry_is_the_low_bit():
+    out = _lift("rol", [EAX, ONE])
+    assert "_cf = (int)((eax) & 1u)" in out, out
+
+
+def test_zero_count_leaves_carry():
+    out = _lift("ror", [EAX, ONE])
+    assert "if ((1) & 31u)" in out, out
+
+
+def test_no_carry_without_cf():
+    assert "_cf" not in _lift("ror", [EAX, ONE], needs_cf=False)
+
+
+def test_function_with_rotate_declares_cf():
+    assert FunctionTranslator._function_needs_cf([_Insn("ror"), _Insn("jb")])
+
+
+if __name__ == "__main__":
+    failed = 0
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_") and callable(fn):
+            try:
+                fn()
+                print("ok  ", name)
+            except AssertionError as e:
+                failed += 1
+                print("FAIL", name, e)
+    sys.exit(1 if failed else 0)
