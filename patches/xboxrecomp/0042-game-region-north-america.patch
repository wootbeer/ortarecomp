--- a/src/kernel/kernel_xbox.c
+++ b/src/kernel/kernel_xbox.c
@@ -11,6 +11,7 @@
 
 #include "kernel.h"
 #include <string.h>
+#include <stdlib.h>   /* getenv, strtoul */
 
 /* ============================================================================
  * Exported Data Objects
@@ -125,6 +126,9 @@
  *   - DVD Region: Region 1 (North America)
  * ============================================================================ */
 
+/* A factory setting, not among kernel.h's user settings. */
+#define XC_FACTORY_GAME_REGION 0x104
+
 NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
     ULONG ValueIndex, PULONG Type, PVOID Value, ULONG ValueLength, PULONG ResultLength)
 {
@@ -202,6 +206,22 @@
         }
         break;
 
+    case XC_FACTORY_GAME_REGION:
+        /* The console's game region (XGetGameRegion): 1 North America,
+         * 2 Japan, 4 the rest of the world. Unhandled it read 0, a region
+         * no console has. Panzer Dragoon Orta sets its difficulty from it
+         * (an offset of 0 for Japan, 1 elsewhere, under every
+         * difficulty-dependent value), so the USA disc played its
+         * difficulties one step off what a USA console gives.
+         * XBOX_GAME_REGION=n answers n instead, to compare. */
+        if (ValueLength >= sizeof(ULONG)) {
+            const char *e = getenv("XBOX_GAME_REGION");
+            *(PULONG)Value = e && *e ? (ULONG)strtoul(e, NULL, 0) : 1;
+            if (Type) *Type = 4;
+            if (ResultLength) *ResultLength = sizeof(ULONG);
+        }
+        break;
+
     default:
         xbox_log(XBOX_LOG_WARN, XBOX_LOG_XBOX,
             "ExQueryNonVolatileSetting: unhandled index 0x%02X", ValueIndex);
