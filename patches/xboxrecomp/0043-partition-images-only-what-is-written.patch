 /* Open a file by delegating to the ported xbox_NtCreateFile kernel HLE. */
+/* Partition devices 1-5 (\Device\Harddisk0\PartitionN), backed by image
+ * files that hold only what was written to them (kernel_path.c,
+ * xbox_PartitionImagesPrepare). Their handles are remembered at the open so
+ * that size queries are answered from the partition table, and reads past an
+ * image's end return zeros, as the unwritten part of a disk does. The first
+ * reads and writes are logged with their place, to show where a title
+ * touches them. */
+unsigned long long xbox_PartitionBytes(int n);     /* kernel_path.c */
+
+#define BRIDGE_PART_MAX 16
+static struct { uint32_t token; int part; } g_part_handles[BRIDGE_PART_MAX];
+
+static int bridge_partition_of_name(const char *name)
+{
+    static const char dev[] = "\\Device\\Harddisk0\\Partition";
+    size_t n = sizeof dev - 1;
+
+    if (!name || _strnicmp(name, dev, n) != 0)
+        return 0;
+    if (name[n] < '1' || name[n] > '5' || name[n + 1] != 0)
+        return 0;
+    return name[n] - '0';
+}
+
+static void bridge_note_partition(uint32_t token, int part)
+{
+    int i;
+    if (!token || !part)
+        return;
+    for (i = 0; i < BRIDGE_PART_MAX; i++)
+        if (!g_part_handles[i].token) {
+            g_part_handles[i].token = token;
+            g_part_handles[i].part = part;
+            return;
+        }
+}
+
+static int bridge_partition_handle(uint32_t token)
+{
+    int i;
+    if (!token)
+        return 0;
+    for (i = 0; i < BRIDGE_PART_MAX; i++)
+        if (g_part_handles[i].token == token)
+            return g_part_handles[i].part;
+    return 0;
+}
+
+static void bridge_forget_partition(uint32_t token)
+{
+    int i;
+    for (i = 0; i < BRIDGE_PART_MAX; i++)
+        if (g_part_handles[i].token == token)
+            g_part_handles[i].token = 0;
+}
+
+static void bridge_partition_io_log(int part, const char *what, long long at, uint32_t len)
+{
+    static int logged;
+    if (logged++ < 64) {
+        fprintf(stderr, "  [PART] Partition%d %s @%lld, %u bytes\n", part, what, at, len);
+        fflush(stderr);
+    }
+}
