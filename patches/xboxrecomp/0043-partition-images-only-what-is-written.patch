+/* ======================================================================== */
+#include <stdlib.h>
+#if !defined(_WIN32)
+#include <fcntl.h>
+#endif
+/* Partition images 1-5: only what the title writes.
+ *
+ * \Device\Harddisk0\Partition1..5 are backed by PartitionN.img in the save
+ * folder. They used to be stretched to the partition's full size (2.2 GB for
+ * E:, 750 MB for each cache) so that the device's size could be read off the
+ * file: sparse, so taking almost no space, but shown at full size by file
+ * managers, and really taking it on a filesystem without sparse files (FAT32
+ * or exFAT, a USB stick). A title writes a few hundred KB at their start --
+ * formatting a cache partition is a boot sector, the cluster table and the
+ * root folder -- and keeps its files in the folders beside them.
+ *
+ * Now the size comes from the partition table (xbox_PartitionBytes, which the
+ * bridge answers size queries from), the image holds only what was written,
+ * and a read past its end returns zeros (the bridge), as the unwritten part of
+ * a disk does. What the title reads is byte for byte what it read before.
+ * Images from before are cut back to their last non-zero byte: everything
+ * past it read as zeros then and reads as zeros now. */
+static const unsigned long long s_partition_bytes[6] = {
+    0,                      /* 0: the whole disk, the partition table's image */
+    0x00465400ull * 512,    /* 1: E: game and saves */
+    0x000FA000ull * 512,    /* 2: C: system */
+    0x00177000ull * 512,    /* 3: X: cache */
+    0x00177000ull * 512,    /* 4: Y: cache */
+    0x00177000ull * 512,    /* 5: Z: cache */
+};
+
+unsigned long long xbox_PartitionBytes(int n)
+{
+    return n >= 1 && n <= 5 ? s_partition_bytes[n] : 0;
+}
+
+#define PART_SCAN_CHUNK (1024u * 1024u)
+
+/* The end of the last non-zero byte in [0, size), scanning back from the end
+ * a chunk at a time; chunk_has_data skips the holes of a sparse file without
+ * reading them. 0 when it is all zeros; size when a read fails (keep it). */
+static unsigned long long part_data_end(void *fh, unsigned long long size,
+        int (*chunk_has_data)(void *fh, unsigned long long lo, unsigned long long hi),
+        int (*read_at)(void *fh, unsigned long long at, unsigned char *buf, unsigned n))
+{
+    unsigned char *buf = malloc(PART_SCAN_CHUNK);
+    unsigned long long hi = size;
+
+    if (!buf)
+        return size;
+    while (hi > 0) {
+        unsigned long long lo = hi > PART_SCAN_CHUNK ? hi - PART_SCAN_CHUNK : 0;
+        if (chunk_has_data(fh, lo, hi)) {
+            unsigned n = (unsigned)(hi - lo);
+            if (!read_at(fh, lo, buf, n)) {
+                free(buf);
+                return size;
+            }
+            while (n > 0 && buf[n - 1] == 0)
+                n--;
+            if (n) {
+                free(buf);
+                return lo + n;
+            }
+        }
+        hi = lo;
+    }
+    free(buf);
+    return 0;
+}
+
+#if defined(_WIN32)
+static int part_has_data_win(void *fh, unsigned long long lo, unsigned long long hi)
+{
+    FILE_ALLOCATED_RANGE_BUFFER q, r;
+    DWORD got = 0;
+
+    q.FileOffset.QuadPart = (LONGLONG)lo;
+    q.Length.QuadPart = (LONGLONG)(hi - lo);
+    if (!DeviceIoControl((HANDLE)fh, FSCTL_QUERY_ALLOCATED_RANGES, &q, sizeof q,
+                         &r, sizeof r, &got, NULL) && GetLastError() != ERROR_MORE_DATA)
+        return 1;                   /* not sparse-aware: read it */
+    return got > 0;
+}
+
+static int part_read_win(void *fh, unsigned long long at, unsigned char *buf, unsigned n)
+{
+    OVERLAPPED ov;
+    DWORD got = 0;
+
+    memset(&ov, 0, sizeof ov);
+    ov.Offset = (DWORD)at;
+    ov.OffsetHigh = (DWORD)(at >> 32);
+    return ReadFile((HANDLE)fh, buf, n, &got, &ov) && got == n;
+}
+
+void xbox_PartitionImagesPrepare(const WCHAR *save_dir)
+{
+    for (int p = 1; p <= 5; p++) {
+        WCHAR image[MAX_PATH];
+        HANDLE h;
+        DWORD ret;
+        LARGE_INTEGER size, end;
+        unsigned long long keep;
+
+        swprintf_s(image, MAX_PATH, L"%s\\Partition%d.img", save_dir, p);
+        h = CreateFileW(image, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                        OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (h == INVALID_HANDLE_VALUE)
+            continue;
+        /* Sparse still, should a title ever write far into it. */
+        DeviceIoControl(h, FSCTL_SET_SPARSE, NULL, 0, NULL, 0, &ret, NULL);
+        if (GetFileSizeEx(h, &size) && size.QuadPart > 0) {
+            keep = part_data_end(h, (unsigned long long)size.QuadPart,
+                                 part_has_data_win, part_read_win);
+            keep = (keep + 511) & ~511ull;
+            if (keep < (unsigned long long)size.QuadPart) {
+                end.QuadPart = (LONGLONG)keep;
+                if (SetFilePointerEx(h, end, NULL, FILE_BEGIN) && SetEndOfFile(h))
+                    fprintf(stderr, "  [PATH] Partition%d.img: %lld bytes -> %llu"
+                                    " (the rest was zeros)\n", p, (long long)size.QuadPart, keep);
+            }
+        }
+        CloseHandle(h);
+    }
+}
+#else
+static int part_has_data_posix(void *fh, unsigned long long lo, unsigned long long hi)
+{
+#ifdef SEEK_DATA
+    off_t d = lseek(*(int *)fh, (off_t)lo, SEEK_DATA);
+    if (d < 0)
+        return errno == ENXIO ? 0 : 1;  /* ENXIO: no data past lo */
+    return (unsigned long long)d < hi;
+#else
+    (void)fh; (void)lo; (void)hi;
+    return 1;
+#endif
+}
+
+static int part_read_posix(void *fh, unsigned long long at, unsigned char *buf, unsigned n)
+{
+    return pread(*(int *)fh, buf, n, (off_t)at) == (ssize_t)n;
+}
+
+void xbox_PartitionImagesPrepare(const char *save_dir)
+{
+    for (int p = 1; p <= 5; p++) {
+        char image[MAX_PATH];
+        struct stat st;
+        int fd;
+        unsigned long long keep;
+
+        snprintf(image, sizeof(image), "%s/Partition%d.img", save_dir, p);
+        fd = open(image, O_RDWR | O_CREAT, 0644);
+        if (fd < 0)
+            continue;
+        if (fstat(fd, &st) == 0 && st.st_size > 0) {
+            keep = part_data_end(&fd, (unsigned long long)st.st_size,
+                                 part_has_data_posix, part_read_posix);
+            keep = (keep + 511) & ~511ull;
+            if (keep < (unsigned long long)st.st_size && ftruncate(fd, (off_t)keep) == 0)
+                fprintf(stderr, "  [PATH] Partition%d.img: %lld bytes -> %llu"
+                                " (the rest was zeros)\n", p, (long long)st.st_size, keep);
+        }
+        close(fd);
+    }
+}
+#endif
